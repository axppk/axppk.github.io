&lt;ul&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/FernRP/FernRPExample&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;对应的仓库&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.bilibili.com/video/BV1BQ4y1U7BX/?spm_id_from=333.337.search-card.all.click&amp;amp;vd_source=7ef3888cbac99bdb5d95af08adacada0&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
